# 请勿覆盖已配置的 .env；将缺少的项目按需补充。
PORT=3000
HOST=127.0.0.1
NODE_ENV=development

# OpenAI-compatible server-side API. Never expose this key in browser code.
AI_API_KEY=
AI_BASE_URL=https://api.example.com/v1
AI_MODEL=
AI_DAILY_LIMIT=20

# Email adapter. Both are required for real verification and digest emails.
RESEND_API_KEY=
MAIL_FROM=
APP_URL=http://127.0.0.1:3000

# Optional persistent data directory. Default: ./data
# DATA_DIR=E:/study-desk-data

# Local debugging only. Production must not expose development codes.
ALLOW_DEV_AUTH=true
